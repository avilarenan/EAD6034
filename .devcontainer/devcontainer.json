{
  "name": "EAD6034 — R e Python: cointegração",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "REditorSupport.r"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/exercicio-cointegracao/.venv/bin/python"
      }
    },
    "codespaces": {
      "openFiles": [
        "exercicio-cointegracao/exercicio_cointegracao.ipynb"
      ]
    }
  },
  "postCreateCommand": "bash exercicio-cointegracao/scripts/setup_python.sh"
}
